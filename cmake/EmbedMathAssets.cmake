# Generate byte arrays so JS and binary font assets need no runtime data path.
# Byte arrays also avoid compiler string-literal length limits for KaTeX's JS.
function(mdread_embed_math_assets output)
  set(math_root "${CMAKE_CURRENT_SOURCE_DIR}/third_party/katex")
  file(GLOB math_fonts CONFIGURE_DEPENDS RELATIVE "${math_root}" "${math_root}/fonts/*.woff2")
  set(math_files katex.min.js katex.min.css ${math_fonts})
  get_filename_component(output_dir "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_dir}")
  set(contents "#pragma once\n#include <array>\n#include <string_view>\nnamespace mdread_math {\nstruct Asset { std::string_view path; std::string_view mime; const unsigned char* data; std::size_t size; };\n")
  set(records "")
  set(index 0)
  foreach(relative IN LISTS math_files)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${math_root}/${relative}")
    file(READ "${math_root}/${relative}" data HEX)
    string(REGEX REPLACE "(..)" "0x\\1," bytes "${data}")
    string(APPEND contents "inline constexpr unsigned char asset_${index}[] = {${bytes}};\n")
    if(relative MATCHES "\\.woff2$")
      set(mime "font/woff2")
    elseif(relative MATCHES "\\.css$")
      set(mime "text/css; charset=utf-8")
    else()
      set(mime "text/javascript; charset=utf-8")
    endif()
    string(APPEND records "Asset{\"${relative}\", \"${mime}\", asset_${index}, sizeof(asset_${index})},\n")
    math(EXPR index "${index} + 1")
  endforeach()
  string(APPEND contents "inline constexpr std::array<Asset, ${index}> assets = {{${records}}};\n}\n")
  file(WRITE "${output}.tmp" "${contents}")
  configure_file("${output}.tmp" "${output}" COPYONLY)
  file(REMOVE "${output}.tmp")
endfunction()
